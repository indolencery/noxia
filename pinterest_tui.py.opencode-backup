    def on_mount(self) -> None:
        for key, value in self.defaults.items():
            try:
                widget = self.query_one(f"#{key}")
            except Exception:
                continue
            if isinstance(widget, Checkbox):
                widget.value = bool(value)
            elif isinstance(widget, Input):
                widget.value = str(value)
        if not shutil.which("pin") and not (Path(__file__).parent / "pin").exists():
            self.notify(
                "Couldn't find a `pin` command on PATH or next to this file — "
                "starting a job will fail until that's fixed.",
                severity="warning",
                timeout=8,
            )
        self.identity_interval_ms = self.read_identity_interval()
        # Refresh the dashboard periodically so cooldowns and stats stay live.
        self.dash_timer = asyncio.create_task(self.dashboard_loop())

    async def dashboard_loop(self) -> None:
        while True:
            try:
                await asyncio.sleep(1)
                await self.refresh_dashboard()
            except asyncio.CancelledError:
                break
            except Exception:
                pass

    async def on_unmount(self) -> None:
        if self.dash_timer:
            self.dash_timer.cancel()

    def read_identity_interval(self) -> int:
        try:
            txt = (Path.home() / "pfp-bot/.env").read_text()
            for line in txt.splitlines():
                if line.strip().startswith("BOT_IDENTITY_INTERVAL_MS="):
                    return max(60000, int(line.split("=", 1)[1].strip()))
        except Exception:
            pass
        return 1800000

    def read_form(self) -> JobOptions:
        def val(id_: str) -> str:
            return self.query_one(f"#{id_}", Input).value

        def flag(id_: str) -> bool:
            return self.query_one(f"#{id_}", Checkbox).value

        return JobOptions(
            path=val("path"),
            threads=val("threads"),
            cut=val("cut"),
            https_proxy=val("https_proxy"),
            http_proxy=val("http_proxy"),
            cookies=val("cookies"),
            force=flag("force"),
            exclude_section=flag("exclude_section"),
            rescrape=flag("rescrape"),
            img_only=flag("img_only"),
            v_only=flag("v_only"),
            board_timestamp=flag("board_timestamp"),
            log_timestamp=flag("log_timestamp"),
        )

    def on_button_pressed(self, event: Button.Pressed) -> None:
        bid = event.button.id
        if bid == "add":
            self.action_add_job()
        elif bid == "start":
            self.action_start_queue()
        elif bid == "stop":
            self.action_stop_current()
        elif bid == "clear":
            self.action_clear_finished()
        elif bid == "dash-start":
            self.dash_start_bot()
        elif bid == "dash-kill":
            self.dash_kill_bot()
        elif bid == "dash-force":
            self.dash_force_identity()
        elif bid == "dash-add-channels":
            self.dash_add_channels()
        elif bid == "dash-dedup-stats":
            self.run_dedup([])
        elif bid == "dash-dedup-scan":
            self.run_dedup(["scan"])
        elif bid == "dash-dedup-rebuild":
            self.run_dedup(["rebuild"])
        elif bid == "dash-dedup-cleanup-dry":
            self.run_dedup(["cleanup"])
        elif bid == "dash-dedup-cleanup-apply":
            self.run_dedup(["cleanup", "--apply"])
        elif bid == "save-fav":
            self.save_favorite()
        elif bid and bid.startswith("fav-"):
            index = int(bid.split("-", 1)[1])
            self.download_favorite(index)

    def save_favorite(self) -> None:
        options = self.read_form()
        if not options.path.strip():
            self.notify("Enter a username, board, section, or URL first.", severity="warning")
            return
        data = load_favorites()
        data.append({"options": asdict(options), "added": int(time.time())})
        save_favorites(data)
        self.notify(f"Saved favorite: {options.path}", severity="information")
        self.query_one("#path", Input).value = ""
        self.set_timer(0.15, self.rebuild_favorites)

    def build_favorite_widgets(self) -> list:
        items = load_favorites()
        self.favorites = []
        if not items:
            return [
                Label("No favorites yet. Fill the NEW JOB form and press \u201c\u2605 Save as favorite\u201d.",
                      id="fav-empty")
            ]
        widgets = []
        for i, item in enumerate(items):
            opts = JobOptions(**item.get("options", {}))
            self.favorites.append(Favorite(options=opts))
            txt = opts.path
            extras = []
            if opts.force:
                extras.append("force")
            if opts.img_only:
                extras.append("img-only")
            if opts.v_only:
                extras.append("video-only")
            if opts.cut.strip():
                extras.append(f"cut={opts.cut}")
            if extras:
                txt += " (" + ", ".join(extras) + ")"
            widgets.append(Button(f"⬇ {txt}", id=f"fav-{i}", classes="fav-btn"))
        return widgets

    def rebuild_favorites(self) -> None:
        try:
            container = self.query_one("#fav-list", Vertical)
        except Exception:
            return
        widgets = self.build_favorite_widgets()
        # Remove old children then mount fresh ones. Removal and mount are
        # awaited so the registry doesn't keep stale fav-* ids around.
        container.remove_children()
        container.mount(*widgets)

    def download_favorite(self, index: int) -> None:
        if index < 0 or index >= len(self.favorites):
            self.notify("No such favorite.", severity="warning")
            return
        fav = self.favorites[index]
        self.notify(f"Downloading favorite: {fav.options.path}", severity="information")
        job = Job(options=fav.options)
        list_view = self.query_one("#queue-list", ListView)
        item = ListItem(Label(f"⏫ {fav.options.path}"))
        job.list_item = item
        list_view.append(item)
        self.jobs.append(job)
        self.action_start_queue()

    def on_mount(self) -> None:
        for key, value in self.defaults.items():
            try:
                widget = self.query_one(f"#{key}")
            except Exception:
                continue
            if isinstance(widget, Checkbox):
                widget.value = bool(value)
            elif isinstance(widget, Input):
                widget.value = str(value)
        if not shutil.which("pin") and not (Path(__file__).parent / "pin").exists():
            self.notify(
                "Couldn't find a `pin` command on PATH or next to this file — "
                "starting a job will fail until that's fixed.",
                severity="warning",
                timeout=8,
            )
        self.identity_interval_ms = self.read_identity_interval()
        self.rebuild_favorites()
        # Refresh the dashboard periodically so cooldowns and stats stay live.
        self.dash_timer = asyncio.create_task(self.dashboard_loop())

    def action_add_job(self) -> None:
        options = self.read_form()
        if not options.path.strip():
            self.notify("Enter a username, board, section, or URL first.", severity="warning")
            return

        save_defaults(options)

        job = Job(options=options)
        list_view = self.query_one("#queue-list", ListView)
        item = ListItem(Label(f"⏳ {options.path}"))
        job.list_item = item
        list_view.append(item)
        self.jobs.append(job)

        self.query_one("#path", Input).value = ""
        self.query_one("#path", Input).focus()

    def action_start_queue(self) -> None:
        if self.queue_task and not self.queue_task.done():
            self.notify("Queue is already running.", severity="information")
            return
        if not any(j.status == "queued" for j in self.jobs):
            self.notify("Nothing queued.", severity="information")
            return
        self.queue_task = asyncio.create_task(self.run_queue())

    def action_stop_current(self) -> None:
        if self.running_process and self.running_process.returncode is None:
            self.running_process.terminate()
            self.set_status_line("Stopping current job...")
        else:
            self.notify("Nothing is running right now.", severity="information")

    def action_clear_finished(self) -> None:
        remaining = []
        for job in self.jobs:
            if job.status in ("done", "error", "stopped"):
                job.list_item.remove()
            else:
                remaining.append(job)
        self.jobs = remaining

    # ------------------------------------------------------------------
    # Dashboard helpers
    # ------------------------------------------------------------------
    async def run_shell(self, argv: list[str]) -> list[str]:
        """Run a command, returning its stdout lines (or [] on failure)."""
        try:
            proc = await asyncio.create_subprocess_exec(
                *argv,
                stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.PIPE,
            )
            out, _ = await proc.communicate()
            return out.decode(errors="replace").splitlines()
        except Exception:
            return []

    def bot_is_running(self) -> bool:
        try:
            out = self.run_subprocess_sync(["pgrep", "-f", "node index.js"])
            return out.strip() != ""
        except Exception:
            return False

    def run_subprocess_sync(self, argv: list[str]) -> str:
        import subprocess

        try:
            return subprocess.run(argv, capture_output=True, text=True, timeout=10).stdout
        except Exception:
            return ""

    async def refresh_dashboard(self) -> None:
        try:
            self.update_bot_status()
            self.update_identity_status()
            await self.update_stats()
            self.update_history()
        except Exception:
            pass

    def update_bot_status(self) -> None:
        el = self.query_one("#dash-bot-status", Static)
        running = self.bot_is_running()
        el.remove_class("-running" if not running else "-stopped")
        el.set_class(running, "-running")
        el.set_class(not running, "-stopped")
        el.update("● Bot is RUNNING" if running else "○ Bot is STOPPED")

    def update_identity_status(self) -> None:
        el = self.query_one("#dash-identity", Static)
        state = {}
        try:
            state = json.loads((Path.home() / "pfp-bot/identity-state.json").read_text())
        except Exception:
            pass
        interval = state.get("interval_ms", self.identity_interval_ms)
        last = state.get("last_change")
        now = int(time.time() * 1000)
        remaining = (last + interval - now) if last else 0
        can = not last or remaining <= 0
        last_txt = "never"
        if last:
            from datetime import datetime, timezone

            try:
                last_txt = datetime.fromtimestamp(last / 1000, timezone.utc).astimezone().strftime("%Y-%m-%d %H:%M:%S")
            except Exception:
                last_txt = str(last)
        next_txt = (f"ready now (every ~{round(interval / 60000)} min)") if can else (f"available in {self.fmt_s(remaining)}")
        c = self._count_some("avatars")
        el.update(
            f"Last pfp/banner change: {last_txt}\n"
            f"Avatar folder: {c[0]} imgs · Banner folder: {c[1]} imgs\n"
            f"Next available: {next_txt}"
        )

    def _count_some(self, which: str):
        if which == "avatars":
            folders = (Path.home() / "pfp-bot/avatars", Path.home() / "pfp-bot/banners")
        else:
            folders = (Path.home() / "pfp-bot/banners",)
        exts = ("jpg", "jpeg", "png", "webp", "gif")
        counts = []
        for f in folders:
            counts.append(sum(1 for x in f.iterdir() if x.is_file() and x.suffix.lower().lstrip(".") in exts) if f.is_dir() else 0)
        return counts

    @staticmethod
    def fmt_s(ms: int) -> str:
        s = max(0, int(ms / 1000))
        m, s = divmod(s, 60)
        if m:
            return f"{m}m {s:02d}s"
        return f"{s}s"

    def dash_start_bot(self) -> None:
        log = self.query_one("#log", RichLog)
        if self.bot_is_running():
            log.write("[info] Bot is already running.")
            return
        import subprocess

        try:
            subprocess.Popen(
                ["bash", "-lc", "cd ~/pfp-bot && setsid node index.js > bot.log 2>&1 < /dev/null & disown"],
                start_new_session=True,
            )
            log.write("[info] Starting bot...")
        except Exception as e:
            log.write(f"[error] Could not start bot: {e}")
        self.update_bot_status()

    def dash_kill_bot(self) -> None:
        log = self.query_one("#log", RichLog)
        try:
            proc = asyncio.create_subprocess_exec("pkill", "-f", "node index.js")
            # fire and forget via a task so we don't block
            async def _kill():
                await proc
                log.write("[info] Kill sent to bot.")
                self.update_bot_status()

            asyncio.create_task(_kill())
        except Exception as e:
            log.write(f"[error] Could not kill bot: {e}")

    def dash_force_identity(self) -> None:
        log = self.query_one("#log", RichLog)

        async def _run():
            lines = await self.run_shell(["force-rotate"])
            js = json.loads("".join(lines) or "{}")
            if js.get("ok"):
                log.write(f"[ok] {js.get('message', 'Identity rotated.')}")
            elif js.get("reason") == "cooldown":
                log.write(f"[warn] {js.get('message', 'Identity cooling down.')}")
            else:
                log.write(f"[error] {js.get('message', 'Rotation failed.')}")
            # note: this writes a lot of discord dotenv noise to stderr — strip to last JSON line
            self.update_identity_status()

        asyncio.create_task(_run())

    def dash_add_channels(self) -> None:
        inp = self.query_one("#dash-channels-input", Input)
        raw = inp.value.strip()
        log = self.query_one("#log", RichLog)
        if not raw:
            self.notify("Enter at least one channel name (and optional id).", severity="warning")
            return
        # Accept comma- and/or space-separated tokens. A bare number is treated
        # as a channel id that applies to the following name token; any other
        # token is a channel name (auto-route folder = lowercased name).
        tokens = [t.strip() for t in raw.replace(",", " ").split() if t.strip()]
        pending_id = None
        for tok in tokens:
            if tok.isdigit():
                pending_id = tok
                continue
            if pending_id is None:
                self._add_channel("", tok, log)
            else:
                self._add_channel(pending_id, tok, log)
                pending_id = None
        inp.value = ""
        asyncio.create_task(self.update_stats())
        self.notify("Channel(s) added.", severity="information")

    async def _add_channel_async(self, cid, name, log):
        argv = ["pfp-channels", "add"] + ([cid, name] if cid else [name])
        lines = await self.run_shell(argv)
        for ln in lines:
            if ln.strip():
                log.write(ln)

    def _add_channel(self, cid, name, log):
        asyncio.create_task(self._add_channel_async(cid, name, log))

    async def update_stats(self) -> None:
        el = self.query_one("#dash-stats", Static)
        pfps = Path.home() / "pfp-bot/pfps"
        channels = self.list_channels()

        lines = []
        total = 0
        for entry in channels:
            cname = entry.get("name", entry.get("folder", ""))
            cnt = self.count_images(pfps / entry.get("folder", cname.lower()) / "sent")
            lines.append(f"  {cname}: {cnt}")
            total += cnt
        lines.append(f"  (root + unmatched sent): {self.count_images(pfps / 'sent')}")

        hashes = self.count_hashes()
        el.update(
            f"TOTAL sent: {total}\n"
            + "\n".join(lines)
            + f"\nHASH DB entries (cached): {hashes}"
        )

    def list_channels(self) -> list[dict]:
        try:
            return json.loads((Path.home() / "pfp-bot/pfps/.channels.json").read_text())
        except Exception:
            return []

    def update_history(self) -> None:
        """Show the most recent downloads (written by pin) in the history panel."""
        el = self.query_one("#dash-history", Static)
        try:
            entries = json.loads(HISTORY_PATH.read_text())
        except Exception:
            entries = []
        if not entries:
            el.update("No downloads yet.")
            return
        lines = []
        for e in entries[-1:-15:-1]:
            ts = e.get("ts", "")[5:16] if e.get("ts") else ""  # MM-DD HH:MM
            path = e.get("path", "")
            new = e.get("new", 0)
            dup = e.get("duplicates_deleted", 0)
            unmatched = e.get("unmatched", 0)
            routes = e.get("channels", {})
            route_txt = ", ".join(f"{k} ({v})" for k, v in routes.items()) if routes else "-"
            extra = f", {unmatched} root" if unmatched else ""
            if new:
                lines.append(f"  {ts}  {path}  →  {new} img → {route_txt}{extra}")
            else:
                lines.append(f"  {ts}  {path}  →  no new (dup: {dup})")
        el.update("\n".join(lines))

    def count_images(self, folder: Path) -> int:
        if not folder.is_dir():
            return 0
        exts = ("jpg", "jpeg", "png", "webp", "gif")
        return sum(1 for f in folder.iterdir() if f.is_file() and f.suffix.lower().lstrip(".") in exts)

    def count_hashes(self) -> int:
        try:
            n = 0
            for line in (Path.home() / "pfp-bot/image-hashes.txt").read_text().splitlines():
                if "|" in line and not line.startswith("#"):
                    n += 1
            return n
        except Exception:
            return 0

    def run_dedup(self, args: list[str]) -> None:
        log = self.query_one("#log", RichLog)
        argv = ["pfp-dedup"] + args
        self.notify(f"Running pfp-dedup {' '.join(args) if args else 'stats'}...", severity="information")

        async def _run():
            log.write(f"\n=== pfp-dedup {' '.join(args) if args else 'stats'} ===")
            lines = await self.run_shell(argv)
            for ln in lines:
                if ln.strip():
                    log.write(ln)
            await self.update_stats()

        asyncio.create_task(_run())

    def set_status_line(self, text: str) -> None:
        self.query_one("#status-line", Static).update(text)

    def set_job_status(self, job: Job, status: str, icon: str) -> None:
        job.status = status
        label = job.list_item.query_one(Label)
        label.update(f"{icon} {job.options.path}")

    async def run_queue(self) -> None:
        log = self.query_one("#log", RichLog)
        for job in self.jobs:
            if job.status != "queued":
                continue

            self.set_job_status(job, "running", "▶")
            log.write(f"\n=== Starting: {job.options.path} ===")
            self.set_status_line(f"Running: {job.options.path}")

            args = [self.pin_cmd] + job.options.build_args()
            try:
                process = await asyncio.create_subprocess_exec(
                    *args,
                    stdout=asyncio.subprocess.PIPE,
                    stderr=asyncio.subprocess.STDOUT,
                )
            except FileNotFoundError:
                log.write(f"[error] Could not run '{self.pin_cmd}' — is it on PATH or next to this file?")
                self.set_job_status(job, "error", "✖")
                continue

            self.running_process = process
            await self.stream_output(process, log)
            returncode = await process.wait()
            self.running_process = None

            if returncode == 0:
                self.set_job_status(job, "done", "✔")
                log.write(f"=== Finished: {job.options.path} ===")
            elif returncode < 0:
                self.set_job_status(job, "stopped", "⏹")
                log.write(f"=== Stopped: {job.options.path} ===")
            else:
                self.set_job_status(job, "error", "✖")
                log.write(f"=== Failed (exit {returncode}): {job.options.path} ===")

        self.set_status_line("Queue idle.")

    async def stream_output(self, process: "asyncio.subprocess.Process", log: RichLog) -> None:
        """Reads raw chunks (not line-buffered) so \\r-terminated progress-bar
        updates are caught too, not just \\n-terminated log lines. \\n lines go
        to the scrolling log; \\r updates go to the status line instead of
        spamming the log with one line per percent."""
        buffer = ""
        assert process.stdout is not None
        while True:
            chunk = await process.stdout.read(256)
            if not chunk:
                break
            buffer += chunk.decode(errors="replace")
            while True:
                idx_n = buffer.find("\n")
                idx_r = buffer.find("\r")
                candidates = [i for i in (idx_n, idx_r) if i != -1]
                if not candidates:
                    break
                idx = min(candidates)
                piece, buffer = buffer[:idx], buffer[idx + 1 :]
                is_newline = idx == idx_n
                text = strip_ansi(piece).strip()
                if not text:
                    continue
                if is_newline:
                    log.write(text)
                else:
                    self.set_status_line(text)
        remainder = strip_ansi(buffer).strip()
        if remainder:
            log.write(remainder)


