ANSI_ESCAPE_RE = re.compile(r"\x1b\[[0-9;]*[a-zA-Z]")

# Shared OMArchy theme file. The TUI's colors adapt live to whichever theme is
# currently active. Falls back to warm-neutral defaults if the file is missing.
COLORS_TOML = Path.home() / ".local/state/omarchy/current/theme/colors.toml"

DEFAULT_COLORS = {
    "bg": "#121113",
    "fg": "#c1c1c1",
    "muted": "#999999",
    "dark": "#171618",
    "card": "#1c1b1d",
    "border": "#2b2b2b",
    "accent": "#fbcb97",
    "teal": "#5f8787",
    "terra": "#e78a53",
    "hover": "#222222",
    "sel": "#333333",
}


def load_colors() -> dict:
    """Read the active omarchy colors.toml into a palette dict.

    The TUI needs a few semantic roles (accent, muted, surface, border).
    How they map from colors.toml:
        accent -> accent
        fg / muted -> foreground / muted
        card / dark / border -> lighter_background / dark_background / border
        teal / terra -> color1 / color3 (the two warm-ish accents in the theme)
    """
    palette = dict(DEFAULT_COLORS)
    try:
        text = COLORS_TOML.read_text(encoding="utf-8")
    except (OSError, FileNotFoundError):
        return palette
    vals = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, raw = line.partition("=")
        val = raw.strip().strip('"').strip("'").strip()
        if val.startswith("#") and len(val) == 7:
            vals[key.strip()] = val
    palette["bg"] = vals.get("background", palette["bg"])
    palette["fg"] = vals.get("foreground", palette["fg"])
    palette["muted"] = vals.get("muted", palette["muted"])
    palette["dark"] = vals.get("dark_background", palette["dark"])
    palette["card"] = vals.get("lighter_background", palette["card"])
    palette["border"] = vals.get("border", palette["border"])
    palette["accent"] = vals.get("accent", palette["accent"])
    palette["hover"] = vals.get("hover", palette["hover"])
    palette["sel"] = vals.get("selection", palette["sel"])
    palette["teal"] = vals.get("color1", palette["teal"])
    palette["terra"] = vals.get("color3", palette["terra"])
    return palette


def strip_ansi(text: str) -> str:
    return ANSI_ESCAPE_RE.sub("", text)


def find_pin_command() -> str:
    """Prefer a `pin` on PATH (how the README examples invoke it); fall back
    to a `pin` script sitting next to this file."""
    on_path = shutil.which("pin")
    if on_path:
        return on_path
    local = Path(__file__).parent / "pin"
    if local.exists():
        return str(local)
    return "pin"  # let it fail loudly at run time with a clear "not found" error


@dataclass
class JobOptions:
    path: str = ""
    threads: str = ""  # blank -> script default
    cut: str = ""  # blank -> script default (-1)
    force: bool = False
    exclude_section: bool = False
    rescrape: bool = False
    img_only: bool = False
    v_only: bool = False
    board_timestamp: bool = False
    log_timestamp: bool = False
    https_proxy: str = ""
    http_proxy: str = ""
    cookies: str = ""

    def build_args(self) -> list[str]:
        """Builds the argument list passed to `pin` (which forwards them
        straight through to pinterest-downloader.py, then appends its own
        -d/--dir last — so we deliberately never pass -d/--dir here, since
        pin's own copy would win anyway)."""
        args: list[str] = []
        if self.threads.strip():
            args += ["--job", self.threads.strip()]
        if self.cut.strip():
            args += ["--cut", self.cut.strip()]
        if self.board_timestamp:
            args.append("--board-timestamp")
        if self.log_timestamp:
            args.append("--log-timestamp")
        if self.force:
            args.append("--force")
        if self.exclude_section:
            args.append("--exclude-section")
        if self.rescrape:
            args.append("--re-scrape")
        if self.img_only:
            args.append("--image-only")
        if self.v_only:
            args.append("--video-only")
        if self.https_proxy.strip():
            args += ["--https-proxy", self.https_proxy.strip()]
        if self.http_proxy.strip():
            args += ["--http-proxy", self.http_proxy.strip()]
        if self.cookies.strip():
            args += ["--cookies", self.cookies.strip()]
        args.append(self.path.strip())
        return args


@dataclass
class Job:
    options: JobOptions
    status: str = "queued"  # queued -> running -> done | error | stopped
    list_item: Optional[ListItem] = field(default=None, repr=False)


@dataclass
class Favorite:
    options: JobOptions
    list_item: Optional[ListItem] = field(default=None, repr=False)
    download_btn: Optional[Button] = field(default=None, repr=False)


def load_favorites() -> list[dict]:
    try:
        return json.loads(FAVORITES_PATH.read_text())
    except Exception:
        return []


def save_favorites(data: list[dict]) -> None:
    try:
        FAVORITES_PATH.write_text(json.dumps(data, indent=2))
    except OSError:
        pass


PERSISTED_FIELDS = [
    "threads",
    "cut",
    "https_proxy",
    "http_proxy",
    "cookies",
    "force",
    "exclude_section",
    "rescrape",
    "img_only",
    "v_only",
    "board_timestamp",
    "log_timestamp",
]


def load_defaults() -> dict:
    if CONFIG_PATH.exists():
        try:
            return json.loads(CONFIG_PATH.read_text())
        except (json.JSONDecodeError, OSError):
            return {}
    return {}


def save_defaults(options: JobOptions) -> None:
    data = {k: v for k, v in asdict(options).items() if k in PERSISTED_FIELDS}
    try:
        CONFIG_PATH.write_text(json.dumps(data, indent=2))
    except OSError:
        pass


